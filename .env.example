# lectual.app runs against the SAME Supabase projects as lectual.
# Dev: lectual-dev (vncamzabuhvlliscprmm). Never point a local .env at prod.
NEXT_PUBLIC_SUPABASE_URL=https://vncamzabuhvlliscprmm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=http://localhost:3000

# Approval queue (lawmatics-mcp). Unset = "unconfigured", never "empty".
QUEUE_API_URL=
DASHBOARD_API_TOKEN=

# AI (step 5). ANTHROPIC_API_KEY wins when both are set.
ANTHROPIC_API_KEY=
VERCEL_AI_GATEWAY_KEY=

# Mailbox OAuth (step 3). Setup: docs/mailbox-oauth-setup.md
# MAILBOX_TOKEN_KEY: `openssl rand -base64 32`, different per environment.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MAILBOX_TOKEN_KEY=

# Vercel Cron shared secret (steps 4–5)
CRON_SECRET=
