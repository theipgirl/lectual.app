# lectual.app runs against the SAME Supabase projects as lectual.
# Dev: lectual-dev (vncamzabuhvlliscprmm). Never point a local .env at prod.
NEXT_PUBLIC_SUPABASE_URL=https://vncamzabuhvlliscprmm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=http://localhost:3000

# Approval queue (lawmatics-mcp). Unset = "unconfigured", never "empty".
QUEUE_API_URL=
DASHBOARD_API_TOKEN=

# AI agents (step 5). Official Anthropic SDK; the agents need ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# Voice notes (optional). Only used for Whisper transcripts; unset = saved untranscribed.
OPENAI_API_KEY=
# Model per job (src/lib/ai/agent-models.ts): Haiku for classification (intake triage, email intel),
# Sonnet for everything that writes. Never Opus by default; an Opus id here is ignored.
# AGENT_MODEL is only the Sonnet-tier override (AGENT_MODEL_SONNET wins over it); it no longer forces every agent.
AGENT_MODEL=
AGENT_MODEL_SONNET=
AGENT_MODEL_HAIKU=
# Failure alerts to Lectual. A failed agent run emails these addresses (comma-separated, e.g. bugs@lectual.app
# and the ClickUp list's email address), at most once per firm + agent + error per UTC day. Unset = no email.
AGENT_FAILURE_ALERT_TO=
AGENT_FAILURE_ALERT_FROM=
# "Send feedback" goes here (comma-separated, e.g. the Resend inbox address bugs@lectual.app forwards to). Unset = "Feedback isn't set up yet."
FEEDBACK_TO=
FEEDBACK_FROM=
RESEND_API_KEY=
# Master-class worksheet (POST /api/worksheet/). WORKSHEET_INTAKE_SLUG = the live intake form's slug the leads are filed
# under (e.g. masterclass-nov-2026). WORKSHEET_FROM must be on a domain verified on RESEND_API_KEY's Resend account.
WORKSHEET_INTAKE_SLUG=
WORKSHEET_NOTIFY_TO=support@rpblawfirm.com,info@rpblawfirm.com
WORKSHEET_FROM=
WORKSHEET_REPLY_TO=
WORKSHEET_ALLOWED_ORIGINS=https://masterclass.rpblawfirm.com
WORKSHEET_LAWMATICS_SYNC=
VERCEL_AI_GATEWAY_KEY=

# Mailbox OAuth (step 3). Setup: docs/mailbox-oauth-setup.md
# MAILBOX_TOKEN_KEY: `openssl rand -base64 32`, different per environment.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MAILBOX_TOKEN_KEY=
# "on" asks Microsoft for the send permission (approval deck: "Send from Outlook now", pressed by a person).
# Default off. Mailboxes connected before it was on must reconnect to grant it.
MAILBOX_SEND_SCOPE=

# Vercel Cron shared secret (steps 4–5)
CRON_SECRET=

# Public intake (/i/<slug>), optional. Salts the anonymous visit/session hash and
# signs the form's render stamp. `openssl rand -base64 32`, different per environment.
# Unset = funnel sessions are not hashed (each event counts on its own).
INTAKE_EVENT_SALT=

# LawPay (AffiniPay) — per-firm "Connect LawPay" sign-in. Setup: docs/lawpay-setup.md
# 8am issues the partner OAuth app (DEV and production are separate apps).
# Unset = the Connect button is disabled with an explanation; manual payment
# recording keeps working. There is NO deployment-wide LawPay secret key.
LAWPAY_OAUTH_CLIENT_ID=
LAWPAY_OAUTH_CLIENT_SECRET=
# Optional overrides:
LAWPAY_OAUTH_AUTHORIZE_URL=
LAWPAY_OAUTH_REDIRECT_URI=
LAWPAY_API_BASE=
# test (default) or live. Only the exact string "live" charges live cards.
LAWPAY_MODE=test

# Meetings — Fathom / Zoom imports. Setup: docs/meetings-setup.md
# Fathom needs NOTHING here: each firm pastes its own API key in
# Settings → Integrations → Meetings (sealed with MAILBOX_TOKEN_KEY).
# Zoom: Lectual's user-managed OAuth app. Unset = "Connect Zoom" shows
# "not set up on this deployment". There is NO deployment-wide Fathom or Zoom
# credential. The daily import runs at /api/cron/meetings-import/ (CRON_SECRET).
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_CLIENT_SECRET=
# Optional: must match the Zoom app's redirect URL exactly.
# Default <origin>/api/meetings/zoom/callback/
ZOOM_OAUTH_REDIRECT_URI=

# Adobe Acrobat Sign (Sprint 5a). Each firm connects ITS OWN Adobe account in Settings -> Integrations; there is no
# deployment-wide Adobe token or key. Unset client id or secret = "not set up": every proposal signs in Lectual.
ADOBE_SIGN_OAUTH_CLIENT_ID=
ADOBE_SIGN_OAUTH_CLIENT_SECRET=
# Optional: must match the Adobe app's redirect URI exactly. Default <origin>/api/esign/callback/
ADOBE_SIGN_OAUTH_REDIRECT_URI=
# Optional: https on a host ending .adobesign.com. Default https://secure.adobesign.com/public/oauth/v2
ADOBE_SIGN_AUTHORIZE_URL=
# OFF by default. Only the exact value "on" lets a client sign on Adobe's page (see AGENTS.md: off in production until
# the sandbox spike and lectual 0113's isolation cases pass).
# ADOBE_SIGN_CLIENT_SIGNING=on

# Client proposal links on a firm's own domain (Sprint 27). JSON { "<org_id>": "https://proposals.firm.com" },
# https and origin only. Unset = every link uses this app's origin. The domain must be a proposals domain
# of the old lectual project (FIRM_PROPOSAL_DOMAINS), which rewrites /p/<token>/ to this app.
FIRM_CLIENT_LINK_ORIGINS=

# USPTO TSDR status reader (src/lib/uspto/, not wired in yet). Key from account.uspto.gov/api-manager. Unset = not set up.
USPTO_TSDR_API_KEY=
